generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  NEW
  ACCEPTED
  COOKING
  READY
  COMPLETED
  CANCELLED
  REJECTED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum OrderType {
  PICKUP
  DELIVERY
}

enum StaffRole {
  MANAGER
  KITCHEN
  ADMIN
}

model StaffUser {
  id       String       @id @default(cuid())
  name     String
  email    String       @unique
  pin      String
  role     StaffRole
  isActive Boolean      @default(true)
  shifts   Shift[]
  events   OrderEvent[]
}

model Shift {
  id             String      @id @default(cuid())
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  openedByUserId String
  openedBy       StaffUser   @relation(fields: [openedByUserId], references: [id])
  status         ShiftStatus @default(OPEN)
  orders         Order[]
}

model MenuCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  isAvailable Boolean      @default(true)
  tags        String       @default("")
  orderItems  OrderItem[]
}

model Order {
  id              String       @id @default(cuid())
  publicId        String       @unique
  orderNumber     Int          @unique
  shiftId         String?
  shift           Shift?       @relation(fields: [shiftId], references: [id])
  status          OrderStatus  @default(NEW)
  customerName    String
  customerPhone   String
  orderType       OrderType    @default(PICKUP)
  deliveryAddress String?
  notes           String?
  subtotalCents   Int
  totalCents      Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  acceptedAt      DateTime?
  cookingAt       DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  items           OrderItem[]
  events          OrderEvent[]
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId         String
  menuItem           MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot       String
  priceCentsSnapshot Int
  quantity           Int
  notes              String?
}

model OrderEvent {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  actor       StaffUser?   @relation(fields: [actorUserId], references: [id])
  actorRole   String
  createdAt   DateTime     @default(now())
}
